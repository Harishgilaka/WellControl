<Window x:Class="WOCS.UI.Dialogs.CustomDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <!-- ✅ Outer Container -->
    <Border Background="White"
            Padding="20"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            Width="450">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ✅ HEADER -->
            <TextBlock x:Name="TitleText"
                       Text="Success"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#059669"
                       Margin="0,0,0,10"/>

            <!-- ✅ MESSAGE -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0,0,0,20"/>

            <!-- ✅ BUTTON -->
            <Button Grid.Row="2"
                    Content="OK"
                    Width="90"
                    Height="35"
                    HorizontalAlignment="Right"
                    Click="Ok_Click"/>
        </Grid>
    </Border>

</Window>
