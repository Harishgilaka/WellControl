<UserControl x:Class="WOCS.UI.Views.DeviceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <Grid Background="#E5E7EB">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- ✅ HEADER -->
        <!-- ================================= -->
        <Border Grid.Row="0" Background="#1F2937" Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- Dynamic space -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Buttons -->
                </Grid.ColumnDefinitions>

                <!-- ✅ Back Button -->
                <Button Content="← Back"
                Padding="10,5"
                Margin="5,0"
                VerticalAlignment="Center"
                Command="{Binding BackCommand}" Cursor="Hand" />

                <!-- ✅ Title -->
                <TextBlock Grid.Column="1"
                   Text="Device Dashboard"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="10,0"/>

                <!-- ✅ RIGHT SIDE NAV (Responsive) -->
                <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button Content="Value Controller"
                    Margin="5,0"
                    Padding="12,6"/>

                    <Button Content="Power Monitor"
                    Margin="5,0"
                    Padding="12,6"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================================= -->
        <!-- ✅ BODY -->
        <!-- ================================= -->
        <Grid Grid.Row="1" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ✅ DEVICE INFO CARD -->
            <Border Background="White"
            Padding="20"
            CornerRadius="8"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            Margin="0,0,20,0">

                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="{Binding ValveName}"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

                    <!-- Grid Layout for Info -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Last Received:" Grid.Row="0"/>
                        <TextBlock Text="{Binding LastReceived}" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Reported Position:" Grid.Row="1"/>
                        <TextBlock Text="{Binding ReportedPosition}" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Remaining Activations:" Grid.Row="2"/>
                        <TextBlock Text="{Binding RemainingActivations}" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Battery Health:" Grid.Row="3"/>
                        <TextBlock Text="{Binding BatteryHealth}" Grid.Row="3" Grid.Column="1"/>
                    </Grid>

                    <!-- Transmission -->
                    <TextBlock Text="Transmission Status"
                       FontWeight="Bold"
                       Margin="0,20,0,5"/>

                    <TextBlock Text="{Binding TransmissionStatusLine1}"/>
                    <TextBlock Text="{Binding TransmissionStatusLine2}"/>

                </StackPanel>
            </Border>

            <!-- ✅ CONTROL PANEL -->
            <Border Grid.Column="1"
            Background="White"
            Padding="20"
            CornerRadius="8"
            BorderBrush="#D1D5DB"
            BorderThickness="1">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Valve Controls"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                    <Button Content="Open"
                    Height="45"
                    Margin="0,0,0,15"
                    Background="#059669"
                    Foreground="White"
                    Command="{Binding OpenCommand}"/>

                    <Button Content="Close"
                    Height="45"
                    Background="#DC2626"
                    Foreground="White"
                    Command="{Binding CloseCommand}"/>

                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</UserControl>