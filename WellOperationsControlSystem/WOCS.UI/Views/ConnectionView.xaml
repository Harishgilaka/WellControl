<UserControl x:Class="WOCS.UI.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WOCS.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="#E5E7EB">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- ✅ HEADER -->
        <!-- ================================= -->
        <Border Grid.Row="0" Background="#1F2937" Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- Dynamic space -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Buttons -->
                </Grid.ColumnDefinitions>

                <!-- ✅ Back Button -->
                <Button Content="← Back"
                        Padding="10,5"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Command="{Binding BackCommand}" Cursor="Hand" />

                <!-- ✅ Title -->
                <TextBlock Grid.Column="1"
                           Text="Controller Connection"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Grid>
        </Border>

        <!-- ================================= -->
        <!-- ✅ BODY -->
        <!-- ================================= -->

        <Grid Grid.Row="1" Margin="20">

            <!-- ✅ DEVICE INFO CARD -->
            <Border Background="White"
                      Padding="30"
                      CornerRadius="8"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ✅ STATUS DISPLAY -->
                    <StackPanel Grid.Row="0"  Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" >

                        <TextBlock Text="Connection Status:"
                           FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding ConnectionStatus}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="15,0,0,0" VerticalAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Default = Disconnected -->
                                    <Setter Property="Foreground" Value="Red"/>

                                    <Style.Triggers>
                                        <!-- Connected = Green -->
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Connection Controls -->
                    <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <!-- ✅ INPUT + BUTTON SECTION -->
                        <!-- IP Address -->
                        <TextBox Width="150"
                             Height="32"
                             Margin="0,0,10,0"
                             Text="{Binding IpAddress}"
                             VerticalContentAlignment="Center" />

                        <!-- Port -->
                        <TextBox Width="80"
                             Height="32"
                             Margin="0,0,10,0"
                             Text="{Binding Port}"
                             VerticalContentAlignment="Center"/>

                        <!-- Connect -->
                        <Button Content="Connect"
                            Width="95"
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding ConnectCommand}" Cursor="Hand" />

                        <!-- Disconnect -->
                        <Button Content="Disconnect"
                            Width="95"
                            Height="32"
                            Command="{Binding DisconnectCommand}" Cursor="Hand" />

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
